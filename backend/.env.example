# Образец. Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен API Kaspi: кабинет продавца → Настройки → Токен API.
KASPI_API_TOKEN=

# Для XML-прайс-листа (всё есть в кабинете продавца Kaspi):
KASPI_COMPANY=
KASPI_MERCHANT_ID=
# Код склада: «Склады и магазины» в кабинете.
KASPI_STORE_ID=
